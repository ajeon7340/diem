{
  "name": "adfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "verify": "npm run verify:actions && npm run verify:candidates && npm run verify:claims && npm run verify:climate && npm run verify:cluster-build && npm run verify:clusters && npm run verify:concurrent && npm run verify:drivers && npm run verify:intent && npm run verify:jobs && npm run verify:keywords && npm run verify:migrations && npm run verify:moderation && npm run verify:onboarding && npm run verify:onboarding-flow && npm run verify:policy && npm run verify:reference && npm run verify:retention && npm run verify:safety && npm run verify:schemas && npm run verify:sufficiency && npm run verify:channel-flow && npm run verify:discovery && npm run verify:discovery-approved && npm run verify:brands && npm run verify:shell && npm run verify:report",
    "ai:check": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/ai-check.ts",
    "dev:session": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/dev-session.ts",
    "retention": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/retention.ts",
    "vercel:env": "bash scripts/vercel-env.sh",
    "verify:actions": "tsx --tsconfig tsconfig.scripts.json scripts/verify-actions.ts",
    "verify:climate": "tsx --tsconfig tsconfig.scripts.json scripts/verify-climate.ts",
    "verify:cluster-build": "tsx --tsconfig tsconfig.scripts.json scripts/verify-cluster-build.ts",
    "verify:clusters": "tsx --tsconfig tsconfig.scripts.json scripts/verify-clusters.ts",
    "verify:concurrent": "tsx --tsconfig tsconfig.scripts.json scripts/verify-concurrent.ts",
    "verify:drivers": "tsx --tsconfig tsconfig.scripts.json scripts/verify-drivers.ts",
    "verify:intent": "tsx --tsconfig tsconfig.scripts.json scripts/verify-intent.ts",
    "verify:jobs": "tsx --tsconfig tsconfig.scripts.json scripts/verify-jobs.ts",
    "verify:keywords": "tsx --tsconfig tsconfig.scripts.json scripts/verify-keywords.ts",
    "verify:migrations": "bash scripts/replay-migrations.sh",
    "verify:moderation": "tsx --tsconfig tsconfig.scripts.json scripts/verify-moderation.ts",
    "verify:onboarding": "tsx --tsconfig tsconfig.scripts.json scripts/verify-onboarding.ts",
    "verify:policy": "tsx --tsconfig tsconfig.scripts.json scripts/verify-policy.ts",
    "verify:retention": "ADFIT_YOUTUBE_DERIVED_APPROVAL=approved tsx --tsconfig tsconfig.scripts.json scripts/verify-retention.ts",
    "verify:safety": "tsx --tsconfig tsconfig.scripts.json scripts/verify-safety.ts",
    "verify:schemas": "tsx --tsconfig tsconfig.scripts.json scripts/verify-schemas.ts",
    "verify:sufficiency": "tsx --tsconfig tsconfig.scripts.json scripts/verify-sufficiency.ts",
    "worker": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/worker.ts",
    "worker:secrets": "bash scripts/worker-secrets.sh",
    "verify:candidates": "tsx --tsconfig tsconfig.scripts.json scripts/verify-candidates.ts",
    "verify:reference": "tsx --tsconfig tsconfig.scripts.json scripts/verify-reference.ts",
    "verify:channel-flow": "tsx --tsconfig tsconfig.scripts.json scripts/verify-channel-flow.ts",
    "verify:claims": "tsx --tsconfig tsconfig.scripts.json scripts/verify-claims.ts",
    "verify:onboarding-flow": "tsx --tsconfig tsconfig.scripts.json scripts/verify-onboarding-flow.ts",
    "verify:discovery": "tsx --tsconfig tsconfig.scripts.json scripts/verify-discovery.ts",
    "verify:discovery-approved": "ADFIT_YOUTUBE_DERIVED_APPROVAL=approved tsx --tsconfig tsconfig.scripts.json scripts/verify-discovery.ts",
    "discovery:check": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/discovery-live-check.ts",
    "verify:brands": "tsx --tsconfig tsconfig.scripts.json scripts/verify-brands.ts",
    "verify:shell": "tsx --tsconfig tsconfig.scripts.json scripts/verify-shell.ts",
    "verify:report": "tsx --tsconfig tsconfig.scripts.json scripts/verify-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
