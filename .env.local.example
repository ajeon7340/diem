# Supabase — omit entirely to run the app on built-in fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the ingestion worker and OAuth callbacks; never exposed
# to the browser and never imported from a component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by the fit-summary server action (src/app/actions/fit-summary.ts).
# Omit and the panel returns an error rather than falling back to canned prose —
# a generated read that is not generated would be the thing the report deleted.
ANTHROPIC_API_KEY=

# Server-only. Used by /dashboard/studio (own-channel drivers, paste-a-link
# analysis, trending) and by the disclosure-rate read. Omit and those surfaces
# render their "could not read" states; the rest of the app is unaffected.
YOUTUBE_API_KEY=

# Model provider. 'anthropic' (default) or 'gemini'. ADFIT_AI_MODEL overrides
# the default model id — set it to an exact id from the provider's model list,
# because the built-in default for gemini is a family name and will 404 rather
# than silently bill for a different model. Check with `npm run ai:check`.
ADFIT_AI_PROVIDER=
ADFIT_AI_MODEL=
GEMINI_API_KEY=

# Shows the sign-in link on screen instead of emailing it, using a REAL
# one-time token. Only the delivery is mocked. Set to 1 to enable.
ADFIT_MOCK_EMAIL=

# Restricted YouTube derived analysis: leave unset unless applicable approval is
# established for this deployment and these uses. Code availability is not approval.
# Set to exactly "approved" only after operator verification. Server-only.
ADFIT_YOUTUBE_DERIVED_APPROVAL=

# Local, OpenAI-compatible model server (llama.cpp, Ollama, vLLM, LM Studio).
# Set ADFIT_AI_PROVIDER=local and point this at it to run every model pass in
# the product with no account and no bill. ADFIT_AI_API_KEY is sent as a bearer
# token only if the server wants one. Schema validation and citation checks are
# identical whichever provider is configured.
ADFIT_AI_BASE_URL=
ADFIT_AI_API_KEY=

# Discovery bounds. Each one caps a SINGLE search run; they exist because the
# project's search budget is small and shared with channel analysis. Defaults in
# src/lib/discovery/limits.ts — 6 searches, 40 quota units, 40 candidates.
ADFIT_DISCOVERY_MAX_SEARCHES=
ADFIT_DISCOVERY_MAX_UNITS=
ADFIT_DISCOVERY_MAX_CANDIDATES=
ADFIT_DISCOVERY_MAX_QUERIES=
ADFIT_DISCOVERY_MAX_VIDEOS=
ADFIT_DISCOVERY_REFERENCE_UPLOADS=
ADFIT_DISCOVERY_MAX_BRANDS=
ADFIT_DISCOVERY_SEARCHES_PER_BRAND=

# What one search.list call is billed at. Google's quota table read 2026-09-20
# says "100 quota per day. Each call costs 1 quota." — a daily cap on search
# CALLS, not 100 units per call — so the default here is 1 and the call count is
# bounded separately. Set to 100 if your console disagrees with the doc; believe
# the console. See src/lib/youtube/quota.ts.
ADFIT_YOUTUBE_SEARCH_UNITS=
