# Supabase — omit entirely to run the app on built-in fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the ingestion worker and OAuth callbacks; never exposed
# to the browser and never imported from a component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by the fit-summary server action (src/app/actions/fit-summary.ts).
# Omit and the panel returns an error rather than falling back to canned prose —
# a generated read that is not generated would be the thing the report deleted.
ANTHROPIC_API_KEY=

# Server-only. Used by /dashboard/studio (own-channel drivers, paste-a-link
# analysis, trending) and by the disclosure-rate read. Omit and those surfaces
# render their "could not read" states; the rest of the app is unaffected.
YOUTUBE_API_KEY=
